sv import from ..services.patchblastService { loadPatchblast, upgradeScenario, resetScenario, getReport }
import from "@hugeicons/react" { HugeiconsIcon }
import from "@hugeicons/core-free-icons" { Shield01Icon, Search01Icon, Refresh01Icon, Download01Icon }
import from "..components.ui.card" { Card, CardHeader, CardTitle, CardDescription, CardContent }
import from "..components.ui.button" { Button }
import from "..components.ui.badge" { Badge }
import from "..components.ui.native_select" { NativeSelect, NativeSelectOption }

def _format_chain(chain: list[str]) -> str { return " → ".join(chain); }

def:pub PatchBlastDashboard() -> JsxElement {
    has data: dict = {};
    has selected: str = "auth-acme";
    has proposed: str = "2.4.0";
    has notice: str = "";
    has active: str = "Overview";

    async can with entry { data = await loadPatchblast([]); }
    def choose_component(e: ChangeEvent) { selected = e.target.value; }
    def choose_version(e: ChangeEvent) { proposed = e.target.value; }
    def nav_overview(e: MouseEvent) { active = "Overview"; }
    def nav_dependencies(e: MouseEvent) { active = "Dependencies"; }
    def nav_advisories(e: MouseEvent) { active = "Advisories"; }
    def nav_investigation(e: MouseEvent) { active = "AI Investigation"; }
    def nav_remediation(e: MouseEvent) { active = "Remediation Lab"; }
    def nav_reports(e: MouseEvent) { active = "Reports"; }
    async def investigate -> None {
        data = await loadPatchblast(data["components"] as list[dict]);
        notice = "Four deterministic Jac analysis roles completed against current inventory.";
    }
    async def simulate -> None {
        data = await upgradeScenario(data["components"] as list[dict], selected, proposed);
        notice = "Scenario-only dependency update applied. All exposure paths recalculated.";
    }
    async def reset -> None {
        data = await resetScenario();
        notice = "Simulation restored to baseline inventory.";
    }
    def report(e: MouseEvent) {
        report_data = getReport(data["components"] as list[dict]);
        notice = "Report generated from the current analysis snapshot: " + str(report_data["analysis"]["potential_count"]) + " potentially affected paths.";
    }
    if len(data) == 0 { return <main className="min-h-svh bg-[#0B1220] p-8 text-slate-300">Loading investigation workspace…</main>; }
    analysis = data["analysis"] as dict;
    findings = analysis["findings"] as list[dict];
    return <div className="min-h-svh bg-[#0B1220] text-slate-100">
        <div className="flex min-h-svh">
            <aside className="hidden w-60 shrink-0 flex-col border-r border-white/10 bg-[#111827] p-5 lg:flex">
                <div className="flex items-center gap-3 border-b border-white/10 pb-5"><div className="flex size-10 items-center justify-center rounded-xl bg-sky-400/15 text-sky-300"><HugeiconsIcon icon={Shield01Icon} strokeWidth={2} className="size-5" /></div><div><h2 className="font-semibold">PatchBlast AI</h2><p className="text-xs text-slate-500">Exposure operations</p></div></div>
                <p className="mb-3 mt-7 text-[10px] font-semibold uppercase tracking-widest text-slate-500">Workspace</p>
                <nav className="flex flex-col gap-1"><button onClick={nav_overview} className="rounded-lg px-3 py-2.5 text-left text-sm text-slate-300 hover:bg-white/5">Overview</button><button onClick={nav_dependencies} className="rounded-lg px-3 py-2.5 text-left text-sm text-slate-300 hover:bg-white/5">Dependencies</button><button onClick={nav_advisories} className="rounded-lg px-3 py-2.5 text-left text-sm text-slate-300 hover:bg-white/5">Advisories</button><button onClick={nav_investigation} className="rounded-lg px-3 py-2.5 text-left text-sm text-slate-300 hover:bg-white/5">AI Investigation</button><button onClick={nav_remediation} className="rounded-lg px-3 py-2.5 text-left text-sm text-slate-300 hover:bg-white/5">Remediation Lab</button><button onClick={nav_reports} className="rounded-lg px-3 py-2.5 text-left text-sm text-slate-300 hover:bg-white/5">Reports</button></nav>
                <div className="mt-auto rounded-xl border border-white/10 bg-white/[0.03] p-4"><p className="mb-2 text-xs font-semibold text-amber-300">SIMULATED DATA</p><p className="text-xs leading-relaxed text-slate-400">Fictional assets and advisory. Potential exposure does not prove exploitability.</p></div>
            </aside>
            <main className="min-w-0 flex-1">
                <header className="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 bg-[#111827] px-4 py-4 sm:px-7"><div className="flex items-center gap-2 lg:hidden"><HugeiconsIcon icon={Shield01Icon} strokeWidth={2} className="size-5 text-sky-300" /><span className="font-semibold">PatchBlast AI</span></div><p className="hidden text-sm text-slate-400 lg:block">NovaCommerce Technologies / {active}</p><Badge variant="outline" className="border-amber-400/30 bg-amber-400/10 text-amber-300">DEMO DATA</Badge></header>
                <div className="flex gap-1 overflow-x-auto border-b border-white/10 bg-[#111827] px-3 py-2 lg:hidden"><button onClick={nav_overview} className="whitespace-nowrap rounded-md px-3 py-2 text-xs text-slate-300">Overview</button><button onClick={nav_dependencies} className="whitespace-nowrap rounded-md px-3 py-2 text-xs text-slate-300">Dependencies</button><button onClick={nav_advisories} className="whitespace-nowrap rounded-md px-3 py-2 text-xs text-slate-300">Advisories</button><button onClick={nav_investigation} className="whitespace-nowrap rounded-md px-3 py-2 text-xs text-slate-300">Investigation</button><button onClick={nav_remediation} className="whitespace-nowrap rounded-md px-3 py-2 text-xs text-slate-300">Remediation</button><button onClick={nav_reports} className="whitespace-nowrap rounded-md px-3 py-2 text-xs text-slate-300">Reports</button></div>
                <div className="mx-auto flex w-full max-w-[1450px] flex-col gap-6 px-4 py-6 sm:px-7 sm:py-8">
                    <div className="flex flex-wrap items-end justify-between gap-4"><div><p className="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-sky-300">Security operations</p><h1 className="text-2xl font-semibold tracking-tight sm:text-3xl">{active}</h1><p className="mt-1 text-sm text-slate-400">One vulnerability. Every dependency. Total visibility.</p></div><Button onClick={investigate} className="bg-sky-400 font-semibold text-slate-950 hover:bg-sky-300"><HugeiconsIcon icon={Search01Icon} strokeWidth={2} className="mr-2 size-4" />Run investigation</Button></div>
                    {notice != "" and <div className="rounded-lg border border-sky-400/20 bg-sky-400/5 px-4 py-3 text-sm text-sky-200">{notice}</div>}
                    <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><Card className="border-white/10 bg-[#1F2937] text-white"><CardContent className="p-5"><p className="text-sm text-slate-400">Applications</p><p className="mt-3 text-3xl font-semibold">{str(data["applications"])}</p><p className="mt-2 text-xs text-slate-500">NovaCommerce inventory</p></CardContent></Card><Card className="border-white/10 bg-[#1F2937] text-white"><CardContent className="p-5"><p className="text-sm text-slate-400">Services</p><p className="mt-3 text-3xl font-semibold">{str(data["services"])}</p><p className="mt-2 text-xs text-slate-500">Connected business systems</p></CardContent></Card><Card className="border-white/10 bg-[#1F2937] text-white"><CardContent className="p-5"><p className="text-sm text-slate-400">Component versions</p><p className="mt-3 text-3xl font-semibold">{str(data["component_count"])}</p><p className="mt-2 text-xs text-slate-500">Known records in inventory</p></CardContent></Card><Card className="border-rose-400/20 bg-[#1F2937] text-white"><CardContent className="p-5"><p className="text-sm text-slate-400">Potentially affected apps</p><p className="mt-3 text-3xl font-semibold text-rose-300">{str(len(analysis["affected_apps"] as list[str]))}</p><p className="mt-2 text-xs text-slate-500">Review priority, not exploitability</p></CardContent></Card></section>
                    <section className="grid gap-5 xl:grid-cols-[1.35fr_1fr]"><Card className="border-white/10 bg-[#1F2937] text-white"><CardHeader className="border-b border-white/10"><div className="flex flex-wrap items-start justify-between gap-3"><div><CardTitle className="text-white">Active security advisory</CardTitle><CardDescription className="mt-1 text-slate-400">Fictional demonstration advisory, not a real CVE</CardDescription></div><Badge variant="outline" className="border-rose-400/30 bg-rose-400/10 text-rose-300">HIGH</Badge></div></CardHeader><CardContent className="flex flex-col gap-4 p-5"><p className="font-mono text-xs text-sky-300">{data["advisory"]["id"]}</p><h3 className="font-medium">{data["advisory"]["title"]}</h3><p className="text-sm leading-relaxed text-slate-400">{data["advisory"]["description"]}</p><div className="grid gap-3 sm:grid-cols-3"><div className="rounded-lg bg-black/20 p-3"><p className="text-xs text-slate-500">Package</p><p className="mt-1 font-mono text-sm">AcmeAuth</p></div><div className="rounded-lg bg-black/20 p-3"><p className="text-xs text-slate-500">Affected range</p><p className="mt-1 font-mono text-sm">2.0.0–2.3.9</p></div><div className="rounded-lg bg-black/20 p-3"><p className="text-xs text-slate-500">Fixed candidate</p><p className="mt-1 font-mono text-sm text-emerald-300">2.4.0</p></div></div></CardContent></Card>
                        <Card className="border-white/10 bg-[#1F2937] text-white"><CardHeader className="border-b border-white/10"><CardTitle className="text-white">Four cooperating Jac roles</CardTitle><CardDescription className="text-slate-400">Structured deterministic agent-style workflow</CardDescription></CardHeader><CardContent className="flex flex-col gap-4 p-5">{for agent in (data["agents"] as list[dict]) { <div key={agent["name"]} className="flex gap-3"><span className="mt-1 size-2 shrink-0 rounded-full bg-sky-300" /><div><p className="text-sm font-medium">{agent["name"]}</p><p className="mt-1 text-xs leading-relaxed text-slate-400">{agent["detail"]}</p></div></div> }}</CardContent></Card></section>
                    <section className="grid gap-5 xl:grid-cols-[1.4fr_1fr]"><Card className="border-white/10 bg-[#1F2937] text-white"><CardHeader className="flex flex-row flex-wrap items-start justify-between gap-3 border-b border-white/10"><div><CardTitle className="text-white">Dependency exposure paths</CardTitle><CardDescription className="mt-1 text-slate-400">Complete evidence chains from application to component</CardDescription></div><Badge variant="outline" className="border-white/10 text-slate-300">{str(len(findings))} paths</Badge></CardHeader><CardContent className="flex flex-col gap-3 p-4">{for (idx, finding) in enumerate(findings) { <div key={str(idx)} className="rounded-lg border border-white/10 bg-black/15 p-4"><div className="flex flex-wrap items-start justify-between gap-2"><div><p className="text-sm font-medium">{finding["application"]} / {finding["service"]}</p><p className="mt-1 text-xs text-slate-500">{finding["criticality"]} criticality</p></div><Badge variant="outline" className="border-white/10 text-xs text-slate-300">{finding["status"]}</Badge></div><div className="mt-3 overflow-x-auto rounded-md bg-[#0B1220] px-3 py-2 font-mono text-xs leading-relaxed text-slate-300">{_format_chain(finding["chain"] as list[str])}</div><div className="mt-3 flex flex-wrap items-center justify-between gap-2"><p className="text-xs leading-relaxed text-slate-400">{finding["evidence"]}</p>{(finding["priority"] as int) > 0 and <span className="whitespace-nowrap text-xs text-amber-300">Review score {finding["priority"]}/100</span>}</div></div> }}</CardContent></Card>
                        <Card className="border-white/10 bg-[#1F2937] text-white"><CardHeader className="border-b border-white/10"><CardTitle className="text-white">Remediation lab</CardTitle><CardDescription className="text-slate-400">Scenario only. Production systems are never modified.</CardDescription></CardHeader><CardContent className="flex flex-col gap-4 p-5"><label className="flex flex-col gap-2 text-xs text-slate-300">Dependency record<NativeSelect value={selected} onChange={choose_component} className="border-white/15 bg-[#0B1220] text-slate-100"><NativeSelectOption value="auth-acme">Customer Portal · Auth API</NativeSelectOption><NativeSelectOption value="checkout-acme">Checkout Platform · Checkout API</NativeSelectOption><NativeSelectOption value="staff-acme">Staff Console · Staff Login</NativeSelectOption></NativeSelect></label><label className="flex flex-col gap-2 text-xs text-slate-300">Proposed version<NativeSelect value={proposed} onChange={choose_version} className="border-white/15 bg-[#0B1220] text-slate-100"><NativeSelectOption value="2.4.0">2.4.0 · fixed candidate</NativeSelectOption><NativeSelectOption value="2.3.1">2.3.1 · affected example</NativeSelectOption><NativeSelectOption value="2.5.0">2.5.0 · later version</NativeSelectOption></NativeSelect></label><div className="flex flex-wrap gap-2"><Button onClick={simulate} className="bg-sky-400 font-semibold text-slate-950 hover:bg-sky-300">Simulate update</Button><Button onClick={reset} variant="outline" className="border-white/15 text-slate-200 hover:bg-white/10"><HugeiconsIcon icon={Refresh01Icon} strokeWidth={2} className="mr-1 size-4" />Reset scenario</Button></div><p className="text-xs leading-relaxed text-slate-500">Only the selected component version changes. All paths are recalculated; shared dependencies may still need review.</p></CardContent></Card></section>
                    <Card className="border-white/10 bg-[#1F2937] text-white"><CardHeader className="flex flex-row flex-wrap items-start justify-between gap-3 border-b border-white/10"><div><CardTitle className="text-white">Investigation report</CardTitle><CardDescription className="mt-1 text-slate-400">Generate a current-scenario summary using Jac service output</CardDescription></div><Button variant="outline" size="sm" onClick={report} className="border-white/15 text-slate-200 hover:bg-white/10"><HugeiconsIcon icon={Download01Icon} strokeWidth={2} className="mr-1 size-4" />Generate report</Button></CardHeader><CardContent className="p-5"><div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">{for component in (data["components"] as list[dict]) { <div key={component["id"]} className="flex items-center justify-between gap-2 rounded-md border border-white/5 px-3 py-2"><span className="text-xs text-slate-300">{component["name"]} <span className="text-slate-500">{component["owner"]}</span></span><span className="font-mono text-xs">{component["version"]}</span></div> }}</div></CardContent></Card>
                    <footer className="border-t border-white/10 pt-4 text-xs leading-relaxed text-slate-500">Potential exposure is not confirmed exploitability. Fictional advisory and inventory. Deterministic Jac workflow; no LLM inference is claimed.</footer>
                </div>
            </main>
        </div>
    </div>;
}
